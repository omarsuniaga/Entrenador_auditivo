{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entrenador-auditivo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-16",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entrenador-auditivo",
      "database_id": "5a1525d0-e244-4cbb-984b-67a74d081154",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DUEL_ROOMS",
        "class_name": "DuelRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-duel-room",
      "new_sqlite_classes": ["DuelRoom"]
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
